# Veyra Website environment configuration
# Copy this file to .env.local and fill in values. Never commit .env.local.
# Values shown are placeholders only - do not use them in production.

# --- Application ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:5173

# --- Veyra Platform API (source of truth for auth, accounts, billing, etc.) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# --- Supabase Auth (browser-based sign-in; website owns the browser flow) ---
# Project URL and anon key are safe to expose in the browser.
# Get these from your Supabase project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Feature flags ---
NEXT_PUBLIC_ENABLE_GSAP=true

# --- Security ---
# Comma-separated list of trusted redirect destinations (relative paths allowed by default).
# Only absolute origins listed here are permitted as post-login/post-action redirects.
NEXT_PUBLIC_TRUSTED_REDIRECT_ORIGINS=http://localhost:5173
